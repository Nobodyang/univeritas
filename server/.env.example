# ===== UniVeritas 后端环境变量示例 =====
# 复制为 .env 或直接 export；server.js 只读环境变量，不自动加载 .env 文件。

# 监听端口
PORT=3000

# 前端静态文件目录（含 index.html；默认取 server/ 上级目录）
# WEB_ROOT=/opt/univeritas

# SQLite 数据目录（默认 server/data）
# DATA_DIR=/opt/univeritas/server/data

# 管理员手机号：该号码注册用户自动 is_admin=1（否则首个注册用户为管理员）
# ADMIN_PHONE=13800000000

# ===== 短信 =====
# console（默认，开发：验证码打印日志+响应带 devCode）
# aliyun / tencent / none（完全关闭短信验证：注册免 code，forgot 不可用）
SMS_PROVIDER=console

# 同号短信重发间隔（毫秒，默认 60000；另有 5 次/小时上限）
# SMS_RESEND_INTERVAL_MS=60000

# 阿里云 SMS（POP API，HMAC-SHA1 签名，服务端手写无需 SDK）
# ALIYUN_SMS_KEY=LTAIxxxxxxxx
# ALIYUN_SMS_SECRET=xxxxxxxx
# ALIYUN_SMS_SIGN=你的签名
# ALIYUN_SMS_TEMPLATE=SMS_xxxxxxx

# 腾讯云 SMS（v3 TC3-HMAC-SHA256 签名，服务端手写无需 SDK）
# TENCENT_SMS_KEY=AKIDxxxxxxxx        # SecretId
# TENCENT_SMS_SECRET=xxxxxxxx         # SecretKey
# TENCENT_SMS_APPID=1400xxxxxx        # SmsSdkAppId
# TENCENT_SMS_SIGN=你的签名
# TENCENT_SMS_TEMPLATE=1234567        # 模板 ID
# TENCENT_SMS_REGION=ap-guangzhou

# ===== 限流 =====
# 登录/注册/短信/重置接口：每 IP 每 5 分钟次数上限（默认 10）
# RATE_LIMIT_AUTH_MAX=10
